# Research Swarm Environment Configuration

# 1. Google Gemini API Key (Gemini 2.5 Flash / Grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Cloud Platform Configuration (Optional for Cloud Run / Firestore)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# 3. Local Development Port
PORT=4000
